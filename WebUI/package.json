{
  "name": "jellyfin-people-discovery-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.tsx --bundle --minify --format=iife --jsx=automatic --outfile=dist/people.bundle.js && postcss src/app.css --use tailwindcss --use autoprefixer --no-map -o dist/people.bundle.css",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/app.tsx --bundle --format=iife --jsx=automatic --outfile=dist/people.bundle.js --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.24.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2"
  }
}
